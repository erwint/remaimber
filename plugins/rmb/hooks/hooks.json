{
  "description": "remaimber: archive this conversation so it stays searchable after Codex prunes or compacts it.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/scripts/ensure-installed.sh\"",
            "async": true,
            "timeout": 300,
            "statusMessage": "Installing remaimber"
          },
          {
            "type": "command",
            "command": "remaimber record-identity >/dev/null 2>&1",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{ remaimber import-if-stale; remaimber summarize-if-stale; } >/dev/null 2>&1",
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "remaimber import >/dev/null 2>&1",
            "timeout": 300,
            "statusMessage": "Archiving before compaction"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{ remaimber import-if-stale; remaimber summarize-if-stale; } >/dev/null 2>&1",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "remaimber mark-ended >/dev/null 2>&1; { remaimber import; remaimber summarize-if-stale; } >/dev/null 2>&1 &",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
